# 👉 Backend: backend/.env.example

PORT=5000
DB_USER=your_mongo_user
DB_PASSWORD=your_mongo_password

JWT_SECRET=your_super_secret_jwt

# Firebase Admin SDK
TYPE=service_account
PROJECT_ID=your_project_id
PRIVATE_KEY_ID=your_private_key_id
PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----\n"
CLIENT_EMAIL=your_firebase_client_email
CLIENT_ID=your_firebase_client_id
AUTH_URI=https://accounts.google.com/o/oauth2/auth
TOKEN_URI=https://oauth2.googleapis.com/token
AUTH_PROVIDER_CERT_URI=https://www.googleapis.com/oauth2/v1/certs
CLIENT_CERT_URI=https://www.googleapis.com/robot/v1/metadata/x509/firebase-adminsdk-xxx%40yourproject.iam.gserviceaccount.com

FRONTEND_ORIGINS=http://localhost:5173

# 👉 Frontend: frontend/.env.example

VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=sender_id
VITE_FIREBASE_APP_ID=app_id
